-        return SDL_SetError("sceKernelWaitEqueue: %s", strerror(errno));
+    /* Keep one frame in flight: wait for the flip of the *previous* frame.
+       Waiting for the frame that was just submitted returns only after that
+       buffer has been scanned out and released, which costs two vertical blanks
+       on this video-out path and pins the loop at half the panel rate: the
+       interface ran at 30 fps (frame 33.4 ms, of which 29.8 ms was this wait)
+       while the frame itself needed 3.5 ms. Waiting one frame behind keeps the
+       same frame work inside a single blank interval. */
+    while (completed < frame_id) {
+        if (sceKernelWaitEqueue(device_data->evt_queue, &evt, 1, &junk, 0)) {
+            return SDL_SetError("sceKernelWaitEqueue: %s", strerror(errno));
+        }
+        ++completed;
     }
     frame_id++;
 
