diff --git a/library/cmake/toolchain.cmake b/library/cmake/toolchain.cmake
index 13227946..a0d3e5f0 100644
--- a/library/cmake/toolchain.cmake
+++ b/library/cmake/toolchain.cmake
@@ -76,6 +76,42 @@ elseif(PLATFORM_PS4)
     set(OPENORBIS $ENV{OPENORBIS} CACHE BOOL "OPENORBIS")
     set(CMAKE_TOOLCHAIN_FILE "${OPENORBIS}/cmake/ps4.cmake" CACHE PATH "toolchain file")
     add_definitions(-DPS4 -D__PS4__)
+elseif(PLATFORM_PS5)
+    message(STATUS "building for PS5")
+    set(USE_SDL2 ON)
+    set(USE_GLFW OFF)
+    set(USE_LIBROMFS ON CACHE BOOL "using libromfs to bundle resources" FORCE)
+    if (NOT LIBROMFS_PREBUILT_GENERATOR)
+        set(LIBROMFS_PREBUILT_GENERATOR "${BOREALIS_DIR}/libromfs-generator" CACHE FILEPATH "prebuilt libromfs generator")
+    endif ()
+    check_libromfs_generator()
+    if (NOT USE_GL2 AND NOT USE_GL3 AND NOT USE_GLES2 AND NOT USE_GLES3)
+        set(USE_GL2 ON)
+    endif ()
+    if (NOT PS5_PAYLOAD_SDK)
+        if (DEFINED ENV{PS5_PAYLOAD_SDK})
+            set(PS5_PAYLOAD_SDK "$ENV{PS5_PAYLOAD_SDK}" CACHE PATH "PS5 payload SDK path")
+        elseif (EXISTS "/opt/ps5-payload-sdk/toolchain/prospero.cmake")
+            set(PS5_PAYLOAD_SDK "/opt/ps5-payload-sdk" CACHE PATH "PS5 payload SDK path")
+        else ()
+            message(FATAL_ERROR "Please set PS5_PAYLOAD_SDK to your PS5 payload SDK path")
+        endif ()
+    endif ()
+    if (NOT EXISTS "${PS5_PAYLOAD_SDK}/toolchain/prospero.cmake")
+        message(FATAL_ERROR "PS5_PAYLOAD_SDK does not contain toolchain/prospero.cmake")
+    endif ()
+    if (NOT PS5_SDL2_PREFIX)
+        message(FATAL_ERROR "Please set PS5_SDL2_PREFIX to the patched SDL2 prefix built by scripts/ps5/build.sh")
+    endif ()
+    if (NOT EXISTS "${PS5_SDL2_PREFIX}/lib/cmake/SDL2/SDL2Config.cmake")
+        message(FATAL_ERROR "PS5_SDL2_PREFIX does not contain lib/cmake/SDL2/SDL2Config.cmake")
+    endif ()
+    set(CMAKE_TOOLCHAIN_FILE "${PS5_PAYLOAD_SDK}/toolchain/prospero.cmake" CACHE PATH "toolchain file")
+    list(PREPEND CMAKE_PREFIX_PATH "${PS5_SDL2_PREFIX}")
+    list(APPEND CMAKE_PREFIX_PATH "${PS5_PAYLOAD_SDK}/target/user/homebrew")
+    set(SDL2_DIR "${PS5_SDL2_PREFIX}/lib/cmake/SDL2" CACHE PATH "SDL2 package directory" FORCE)
+    add_definitions(-DPS5 -D__PS5__ -DPROSPERO)
+    add_compile_options(-Wno-error=pedantic -Wno-psabi)
 elseif (PLATFORM_SWITCH)
     message(STATUS "building for SWITCH")
     if (NOT DEFINED ENV{DEVKITPRO})
